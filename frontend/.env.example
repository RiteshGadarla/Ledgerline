# Copy to frontend/.env.local and fill in. Next.js loads .env.local
# automatically; .env.example is the only env file that gets committed.

# Where the route-handler proxy at app/api/[...path]/route.ts forwards to.
# It is read server-side only and is deliberately not NEXT_PUBLIC_*: the
# browser never talks to the API origin directly, it only ever calls this
# app's own /api, which is what keeps the session cookie same-origin.
# Defaults to http://localhost:8000 when unset.
LEDGERLINE_API_URL=http://localhost:8000
