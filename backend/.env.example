# Copy to backend/.env and fill in. Real values never get committed --
# .gitignore covers .env and .env.*, with .env.example the one exception.
# Every name here is read by app/settings.py unless noted otherwise.

# "dev" is the only value that relaxes anything: the session cookie drops its
# `secure` flag, because local dev is plain HTTP and TLS termination is
# expected in front of the app everywhere else (app/routers/auth.py).
ENV=dev

# One key, or a comma-separated list of any length -- free-tier quota is per
# key, so N keys are N independent RPM/RPD buckets (llm/keys.py). Blanks and
# duplicates are dropped. Leave it empty to run without a model: the app
# starts and degrades to the scripted/fake clients instead of failing.
GEMINI_API_KEY=

# Postgres and Redis. Without them the backend still starts and serves
# /health; any route needing either returns 503. These match docker/compose.yaml.
DATABASE_URL=postgresql+asyncpg://ledgerline:ledgerline@localhost:5432/ledgerline
REDIS_URL=redis://localhost:6379

SESSION_COOKIE_NAME=ledgerline_session

# Set LOG_DIR empty to log to stdout only, which is what you want behind a
# collector that already ships it somewhere (app/logging_config.py).
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Quota governor (llm/limits.py). All optional; the defaults shown are
# what the code uses when unset. They are deliberately conservative -- a free
# key's real per-day ceiling runs well below the published figure, and the
# governor is what turns "over quota" into an instant refusal instead of a
# slow upstream failure. When in doubt, set these too low rather than too high.
# GEMMA_PRIMARY_RPM=10
# GEMMA_PRIMARY_RPD=250
# GEMMA_PRIMARY_TPM=250000
# GEMMA_BACKUP_RPM=15
# GEMMA_BACKUP_RPD=1000
# GEMMA_BACKUP_TPM=250000

# Per-user calls per day. Unset, it scales with the size of the key pool;
# set, it is honoured as an absolute ceiling (llm/limits.py).
# LLM_USER_DAILY_QUOTA=25

# Rows a single LLM tool call may return (llm/tools.py).
# LLM_TOOL_MAX_ROWS=20

# Read only by tests/conftest.py, which skips rather than fails when the
# database is absent. REDIS_URL above doubles as the test Redis (db 15).
# DATABASE_TEST_URL=postgresql+asyncpg://ledgerline:ledgerline@localhost:5432/ledgerline_test
